<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="?android:attr/colorBackground" />
            <stroke android:width="3dp" android:color="?android:attr/colorAccent" />
            <corners android:radius="16dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="?android:attr/colorControlHighlight" />
            <corners android:radius="16dp" /></shape>
    </item>
    <item><shape><solid android:color="?android:attr/colorBackground" />
        <stroke android:width="1dp" android:color="?android:attr/textColorSecondary" />
        <corners android:radius="16dp" /></shape></item>
</selector>
